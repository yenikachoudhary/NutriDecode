APP_NAME=NutriDecode API
APP_VERSION=0.2.0
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# AI Provider Configuration
# Set your Google Gemini API key (recommended free tier from Google AI Studio)
AI_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI or compatible provider
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

AI_TIMEOUT_SECONDS=25.0
